{
  "openapi": "3.0.0",
  "info": {
    "title": "Kafup API",
    "version": "1.0.0",
    "description": "This is the official API documentation for the Kafup platform."
  },
  "servers": [
    {
      "url": "http://localhost:5000/api/v1"
    },
    {
      "url": "https://kafupbackend.vercel.app/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Electronics"
          },
          "description": {
            "type": "string",
            "example": "Category for electronic products"
          },
          "status": {
            "type": "string",
            "example": "active"
          },
          "designer": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "DES001"
              }
            }
          }
        }
      },
      "Designer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "des-123"
          },
          "code": {
            "type": "string",
            "example": "DES001"
          },
          "brandName": {
            "type": "string",
            "example": "Awesome Designs"
          },
          "contactName": {
            "type": "string",
            "example": "John Doe"
          },
          "contactEmail": {
            "type": "string",
            "example": "john.doe@example.com"
          },
          "contactPhone": {
            "type": "string",
            "example": "+233245678901"
          },
          "profileImg": {
            "type": "string",
            "example": "https://cloudinary.com/image.jpg"
          },
          "pitch": {
            "type": "string",
            "example": "We create amazing designs"
          },
          "socialFb": {
            "type": "string",
            "example": "https://facebook.com/awesome"
          },
          "socialIg": {
            "type": "string",
            "example": "https://instagram.com/awesome"
          },
          "socialTw": {
            "type": "string",
            "example": "https://twitter.com/awesome"
          },
          "socialTk": {
            "type": "string",
            "example": "https://tiktok.com/@awesome"
          },
          "socialYt": {
            "type": "string",
            "example": "https://youtube.com/awesome"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Design": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "design-123"
          },
          "name": {
            "type": "string",
            "example": "Summer Collection Dress"
          },
          "description": {
            "type": "string",
            "example": "Beautiful summer dress with African prints"
          },
          "price": {
            "type": "number",
            "example": 150.5
          },
          "designer": {
            "type": "object"
          },
          "category": {
            "type": "object"
          },
          "previewImg": {
            "type": "string",
            "example": "https://cloudinary.com/preview.jpg"
          },
          "variations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "color": {
                  "type": "string",
                  "example": "red"
                },
                "size": {
                  "type": "string",
                  "example": "M"
                },
                "quantity": {
                  "type": "number",
                  "example": 50
                }
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "order-123"
          },
          "reference": {
            "type": "string",
            "example": "PAY-REF-12345"
          },
          "customer": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "cust-001"
              },
              "email": {
                "type": "string",
                "example": "customer@example.com"
              },
              "firstName": {
                "type": "string",
                "example": "John"
              },
              "lastName": {
                "type": "string",
                "example": "Doe"
              },
              "phone": {
                "type": "string",
                "example": "+233245678901"
              }
            }
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "total": {
            "type": "number",
            "example": 301
          },
          "status": {
            "type": "string",
            "example": "completed"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": "123"
          },
          "name": {
            "type": "string",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "example": "john@example.com"
          },
          "isEmailVerified": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "id",
          "name",
          "email"
        ]
      }
    }
  },
  "paths": {
    "/categories/all": {
      "get": {
        "tags": [
          "Categories"
        ],
        "description": "Get all categories for a designer",
        "parameters": [
          {
            "name": "designercode",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "example": "DES001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid designer code",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid designer code"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/categories/": {
      "post": {
        "tags": [
          "Categoxries"
        ],
        "description": "Create a new category for a designer",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Electronics"
                  },
                  "designercode": {
                    "type": "string",
                    "example": "DES001"
                  }
                },
                "required": [
                  "name",
                  "designercode"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Category created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Category"
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully created category"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request or category already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },
    "/designers/register": {
      "post": {
        "tags": [
          "Designers"
        ],
        "description": "Create a new designer and generate a unique designer code",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "brand_name": {
                    "type": "string",
                    "example": "Awesome Designs"
                  },
                  "contact_name": {
                    "type": "string",
                    "example": "John Doe"
                  },
                  "contact_email": {
                    "type": "string",
                    "example": "john.doe@example.com"
                  },
                  "contact_phone": {
                    "type": "string",
                    "example": "+233245678901"
                  },
                  "profile_img": {
                    "type": "string",
                    "example": "https://cloudinary.com/profile.jpg"
                  },
                  "pitch": {
                    "type": "string",
                    "example": "We create unique and beautiful designs"
                  },
                  "social_fb": {
                    "type": "string",
                    "example": "https://facebook.com/awesome"
                  },
                  "social_ig": {
                    "type": "string",
                    "example": "https://instagram.com/awesome"
                  },
                  "social_tw": {
                    "type": "string",
                    "example": "https://twitter.com/awesome"
                  },
                  "social_tk": {
                    "type": "string",
                    "example": "https://tiktok.com/@awesome"
                  },
                  "social_yt": {
                    "type": "string",
                    "example": "https://youtube.com/awesome"
                  }
                },
                "required": [
                  "brand_name",
                  "contact_name",
                  "contact_email",
                  "contact_phone"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Designer created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "example": "des-uuid-123"
                    },
                    "code": {
                      "type": "string",
                      "example": "DES001"
                    },
                    "brandName": {
                      "type": "string",
                      "example": "Awesome Designs"
                    },
                    "contactName": {
                      "type": "string",
                      "example": "John Doe"
                    },
                    "contactEmail": {
                      "type": "string",
                      "example": "john.doe@example.com"
                    },
                    "contactPhone": {
                      "type": "string",
                      "example": "+233245678901"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request or designer already exists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs": {
      "get": {
        "tags": [
          "Designs"
        ],
        "description": "Get all designs with pagination",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "number",
              "default": 5
            },
            "description": "Number of designs to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved all designs",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Design"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No designs found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/api/v1/designs/product": {
      "post": {
        "tags": [
          "Designs"
        ],
        "description": "Create a new design product with variations and images",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "example": "Summer Collection Dress"
                  },
                  "description": {
                    "type": "string",
                    "example": "Beautiful summer dress with African prints"
                  },
                  "price": {
                    "type": "string",
                    "example": "150.50"
                  },
                  "designer_code": {
                    "type": "string",
                    "example": "DES001"
                  },
                  "cat_code": {
                    "type": "string",
                    "example": "CAT001"
                  },
                  "collection_code": {
                    "type": "string",
                    "example": "COL001"
                  },
                  "variations": {
                    "type": "string",
                    "example": "[{\"color\":\"red\",\"size\":\"M\",\"quantity\":10,\"bust\":\"85\",\"hip\":\"95\",\"waist\":\"65\",\"neck\":\"35\",\"sleeve\":\"20\",\"gender\":\"female\"}]"
                  },
                  "previewimg": {
                    "type": "string",
                    "format": "binary"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  }
                },
                "required": [
                  "name",
                  "price",
                  "designer_code",
                  "cat_code",
                  "variations",
                  "previewimg"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Design created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": true
                    },
                    "message": {
                      "type": "string",
                      "example": "Product created successfully"
                    },
                    "product": {
                      "$ref": "#/components/schemas/Design"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - validation error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean",
                      "example": false
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs/product/{id}": {
      "put": {
        "tags": [
          "Designs"
        ],
        "description": "Update an existing design product",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Design ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "price": {
                    "type": "string"
                  },
                  "designer_code": {
                    "type": "string"
                  },
                  "cat_code": {
                    "type": "string"
                  },
                  "collection_code": {
                    "type": "string"
                  },
                  "variations": {
                    "type": "string"
                  },
                  "previewimg": {
                    "type": "string",
                    "format": "binary"
                  },
                  "images": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    }
                  },
                  "delImgs": {
                    "type": "string",
                    "example": "[{\"pid\":\"img1\",\"url\":\"public_id1\"}]"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Design updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    },
                    "product": {
                      "$ref": "#/components/schemas/Design"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "404": {
            "description": "Design not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "get": {
        "tags": [
          "Designs"
        ],
        "description": "Get a specific design by ID with all relations",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Design ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Design retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Design"
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing ID"
          },
          "404": {
            "description": "Design not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs/{designercode}": {
      "get": {
        "tags": [
          "Designs"
        ],
        "description": "Get all designs by a specific designer",
        "parameters": [
          {
            "in": "path",
            "name": "designercode",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Designer code"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "number",
              "default": 5
            },
            "description": "Number of designs to retrieve"
          }
        ],
        "responses": {
          "200": {
            "description": "Designs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Design"
                  }
                }
              }
            }
          },
          "404": {
            "description": "No products found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs/productClick/{prodId}": {
      "patch": {
        "tags": [
          "Designs"
        ],
        "description": "Update the click count for a design",
        "parameters": [
          {
            "in": "path",
            "name": "prodId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Click count updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs/popularProducts": {
      "get": {
        "tags": [
          "Designs"
        ],
        "description": "Get the most popular designs (with clicks >= average)",
        "responses": {
          "200": {
            "description": "Popular designs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Design"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs/del/{prodId}": {
      "delete": {
        "tags": [
          "Designs"
        ],
        "description": "Delete a design product",
        "parameters": [
          {
            "in": "path",
            "name": "prodId",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Product ID"
          }
        ],
        "responses": {
          "200": {
            "description": "Design deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/designs/catproduct/{catalias}": {
      "get": {
        "tags": [
          "Designs"
        ],
        "description": "Get all designs in a specific category",
        "parameters": [
          {
            "in": "path",
            "name": "catalias",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Category alias"
          }
        ],
        "responses": {
          "200": {
            "description": "Designs retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Design"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad request - missing category alias"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/orders/processOrder": {
      "post": {
        "tags": [
          "Orders"
        ],
        "description": "Create a new order and initialize payment with Paystack",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "customer": {
                    "type": "object",
                    "required": [
                      "id",
                      "email",
                      "firstName",
                      "lastName",
                      "phone",
                      "address",
                      "city",
                      "region"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "example": "cust_001"
                      },
                      "email": {
                        "type": "string",
                        "example": "customer@example.com"
                      },
                      "firstName": {
                        "type": "string",
                        "example": "John"
                      },
                      "lastName": {
                        "type": "string",
                        "example": "Doe"
                      },
                      "phone": {
                        "type": "string",
                        "example": "+233245678901"
                      },
                      "address": {
                        "type": "string",
                        "example": "123 Main Street"
                      },
                      "city": {
                        "type": "string",
                        "example": "Accra"
                      },
                      "region": {
                        "type": "string",
                        "example": "Greater Accra"
                      }
                    }
                  },
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": [
                        "designId",
                        "quantity",
                        "size",
                        "color",
                        "price"
                      ],
                      "properties": {
                        "designId": {
                          "type": "string",
                          "example": "design-uuid-123"
                        },
                        "quantity": {
                          "type": "number",
                          "example": 2
                        },
                        "size": {
                          "type": "string",
                          "example": "M"
                        },
                        "color": {
                          "type": "string",
                          "example": "red"
                        },
                        "price": {
                          "type": "number",
                          "example": 150.5
